{% extends 'base.html.twig' %}

{% block title %}Inscription - {{ app_name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .register-container {
            max-width: 600px;
            margin: 40px auto;
            padding: 30px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .password-help {
            font-size: 0.9rem;
            color: #6c757d;
        }

        .input-group-text {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
        }

        .was-validated .form-control:valid {
            border-color: #198754;
        }

        .was-validated .form-control:invalid {
            border-color: #dc3545;
        }

        .validation-errors {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 5px;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="register-container">
        <h1 class="text-center mb-4">
            <i class="fas fa-user-plus text-primary"></i>
            Formulaire d'Inscription
        </h1>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {{ form_start(registerForm, { 'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'} }) }}

        <!-- Champ Email avec personnalisation -->
        <div class="mb-4">
            {{ form_label(registerForm.email, null, {
                'label_attr': {'class': 'form-label'}
            }) }}

            <div class="input-group">
                {{ form_widget(registerForm.email, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'exemple@ehei.ac.ma',
                        'aria-label': 'Email'
                    }
                }) }}
                <span class="input-group-text">@ehei.ac.ma</span>
            </div>

            <div class="validation-errors">
                {{ form_errors(registerForm.email) }}
            </div>
        </div>

        <!-- Champ Mot de passe avec personnalisation -->
        <div class="mb-4">
            {{ form_label(registerForm.password.first, null, {
                'label_attr': {'class': 'form-label'}
            }) }}

            <div class="row">
                <div class="col-md-6 mb-3">
                    {{ form_widget(registerForm.password.first, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Votre mot de passe'
                        }
                    }) }}
                    <div class="validation-errors">
                        {{ form_errors(registerForm.password.first) }}
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    {{ form_widget(registerForm.password.second, {
                        'attr': {
                            'class': 'form-control',
                            'placeholder': 'Confirmez le mot de passe'
                        }
                    }) }}
                    <div class="validation-errors">
                        {{ form_errors(registerForm.password.second) }}
                    </div>
                </div>
            </div>

            <!-- Aide pour le mot de passe -->
            <div class="password-help">
                {{ form_help(registerForm.password.first) }}
            </div>
        </div>

        <!-- Champ Nom complet -->
        <div class="mb-4">
            {{ form_label(registerForm.fullName, null, {
                'label_attr': {'class': 'form-label'}
            }) }}

            {{ form_widget(registerForm.fullName, {
                'attr': {
                    'class': 'form-control',
                    'placeholder': 'Votre nom complet'
                }
            }) }}

            <div class="validation-errors">
                {{ form_errors(registerForm.fullName) }}
            </div>
        </div>

        <!-- Bouton de soumission -->
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="fas fa-user-plus me-2"></i>
                S'inscrire
            </button>
        </div>

        {{ form_end(registerForm) }}

        <!-- Lien vers la connexion -->
        <div class="text-center mt-4">
            <p class="text-muted">
                Déjà inscrit ?
                <a href="#" class="text-decoration-none">Connectez-vous ici</a>
            </p>
        </div>
    </div>
{% endblock %}
