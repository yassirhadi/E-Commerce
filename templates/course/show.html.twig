{% extends 'base.html.twig' %}

{% block title %}{{ course.title }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card">
        <div class="card-header">
            <h1 class="mb-0">{{ course.title }}</h1>
        </div>

        <div class="card-body">
            {% if course.summary %}
                <div class="mb-4">
                    <h4>Description :</h4>
                    <p class="lead">{{ course.summary|nl2br }}</p>
                </div>
            {% endif %}

            {% if course.filePath %}
                <div class="mb-4 p-3 border rounded bg-light">
                    <h4>Fichier attaché :</h4>
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <i class="fa {{ course.fileIcon }} fa-3x"></i>
                        </div>
                        <div class="flex-grow-1">
                            <h5>{{ course.originalFilename ?: 'Document' }}</h5>
                            <p class="mb-1">
                                <i class="fas fa-file"></i>
                                Type:
                                {% if course.fileType %}
                                    {{ course.fileType|split('/')[1]|upper }}
                                {% else %}
                                    Non spécifié
                                {% endif %}
                            </p>
                            <p class="mb-1">
                                <i class="fas fa-weight"></i> Taille: {{ course.formattedFileSize }}
                            </p>
                            <p class="mb-0">
                                <i class="fas fa-calendar"></i>
                                Ajouté le {{ course.createdAt|date('d/m/Y à H:i') }}
                            </p>
                        </div>
                        <div>
                            <a href="{{ path('course_download', {'id': course.id}) }}"
                               class="btn btn-lg btn-success">
                                <i class="fas fa-download"></i> Télécharger
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="card-footer">
            <a href="{{ path('course_index') }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Retour à la bibliothèque
            </a>
            <a href="{{ path('course_new') }}" class="btn btn-primary">
                <i class="fas fa-plus"></i> Ajouter un autre cours
            </a>
        </div>
    </div>
</div>
{% endblock %}
