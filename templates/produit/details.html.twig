{# templates/produit/details.html.twig #}
{% extends 'base/modele.html.twig' %}

{% block titre %}{{ produit.name }} - Ma Boutique{% endblock %}

{% block contenu %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-6">
            <img src="{{ asset('medias/produits/' ~ (produit.image ?: 'default.png')) }}"
                 class="img-fluid rounded"
                 alt="{{ produit.name }}">
        </div>

        <div class="col-md-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_accueil') }}" class="text-decoration-none">Accueil</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_categorie_parcourir') }}" class="text-decoration-none">Catégories</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_produit_liste', {'slug': produit.category.slug}) }}"
                           class="text-decoration-none">{{ produit.category.name }}</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">{{ produit.name }}</li>
                </ol>
            </nav>

            <span class="badge bg-{{ produit.category.badgeColor }} mb-3">{{ produit.category.name }}</span>

            <h1 class="mb-3">{{ produit.name }}</h1>
            <h3 class="text-success mb-4">{{ produit.price|number_format(2, ',', ' ') }} €</h3>

            <div class="mb-4">
                <h5>Description</h5>
                <p class="text-muted">{{ produit.description ?: 'Aucune description disponible.' }}</p>
            </div>

            {# Formulaire AJOUT AU PANIER — POST vers PanierController::ajouter #}
            <form action="{{ path('app_panier_ajouter', {'id': produit.id}) }}" method="POST">
                <div class="mb-3">
                    <label for="quantite" class="form-label">Quantité</label>
                    <input type="number"
                           class="form-control"
                           id="quantite"
                           name="quantite"
                           value="1"
                           min="1"
                           max="{{ produit.stock }}"
                           style="max-width: 100px;"
                           {{ produit.stock == 0 ? 'disabled' : '' }}>
                </div>
                <div class="d-grid gap-2 d-md-flex">
                    <button type="submit"
                            class="btn btn-primary btn-lg"
                            {{ produit.stock == 0 ? 'disabled' : '' }}>
                        {% if produit.stock > 0 %}
                            🛒 Ajouter au panier
                        {% else %}
                            Rupture de stock
                        {% endif %}
                    </button>
                    <a href="{{ path('app_accueil') }}" class="btn btn-outline-secondary btn-lg">
                        Continuer vos achats
                    </a>
                </div>
            </form>

            <div class="mt-4 pt-4 border-top">
                <ul class="list-unstyled">
                    <li class="mb-2"><strong>SKU :</strong> {{ produit.sku }}</li>
                    <li class="mb-2">
                        <strong>Disponibilité :</strong>
                        <span class="{{ produit.stock > 0 ? 'text-success' : 'text-danger' }}">
                            {{ produit.stock > 0 ? 'En stock (' ~ produit.stock ~ ' disponibles)' : 'Rupture de stock' }}
                        </span>
                    </li>
                    <li class="mb-2"><strong>Catégorie :</strong> {{ produit.category.name }}</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
