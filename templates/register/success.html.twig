{% extends 'base.html.twig' %}

{% block title %}Inscription réussie - {{ app_name }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card text-center border-success">
                    <div class="card-header bg-success text-white">
                        <h3 class="mb-0">
                            <i class="fas fa-check-circle me-2"></i>
                            Inscription réussie !
                        </h3>
                    </div>
                    <div class="card-body py-5">
                        <div class="mb-4">
                            <i class="fas fa-envelope-circle-check fa-4x text-success"></i>
                        </div>

                        <h4 class="card-title mb-3">Félicitations !</h4>

                        <p class="card-text lead mb-4">
                            Votre inscription a été effectuée avec succès.
                        </p>

                        <div class="alert alert-info mx-auto" style="max-width: 500px;">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>Email enregistré :</strong> {{ email }}
                        </div>

                        <p class="text-muted mb-4">
                            Un email de confirmation a été envoyé à votre adresse.
                            Veuillez vérifier votre boîte de réception.
                        </p>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="{{ path('app_register') }}" class="btn btn-outline-primary">
                                <i class="fas fa-user-plus me-2"></i>
                                Nouvelle inscription
                            </a>
                            <a href="#" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>
                                Se connecter
                            </a>
                        </div>
                    </div>
                    <div class="card-footer text-muted">
                        Plateforme EHEI &copy; {{ "now"|date("Y") }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
