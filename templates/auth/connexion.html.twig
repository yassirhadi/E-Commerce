{# templates/auth/connexion.html.twig #}
{% extends 'base/modele.html.twig' %}

{% block titre %}Connexion - Ma Boutique{% endblock %}

{% block contenu %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow">
                <div class="row g-0">

                    {# Connexion #}
                    <div class="col-md-6">
                        <div class="card-body p-5">
                            <h2 class="card-title mb-4">Connexion</h2>

                            {% if erreur %}
                                <div class="alert alert-danger">
                                    {{ erreur.messageKey|trans(erreur.messageData, 'security') }}
                                </div>
                            {% endif %}

                            {% for message in app.flashes('success') %}
                                <div class="alert alert-success">{{ message }}</div>
                            {% endfor %}

                            <form action="{{ path('app_connexion') }}" method="POST">
                                <div class="mb-3">
                                    <label for="email" class="form-label">Adresse email</label>
                                    <input type="email"
                                           class="form-control"
                                           id="email"
                                           name="email"
                                           value="{{ dernierEmail }}"
                                           required>
                                </div>
                                <div class="mb-3">
                                    <label for="password" class="form-label">Mot de passe</label>
                                    <input type="password"
                                           class="form-control"
                                           id="password"
                                           name="password"
                                           required>
                                </div>
                                <div class="mb-3 form-check">
                                    <input type="checkbox" class="form-check-input"
                                           id="remember_me" name="_remember_me">
                                    <label class="form-check-label" for="remember_me">
                                        Se souvenir de moi
                                    </label>
                                </div>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        Se connecter
                                    </button>
                                </div>
                            </form>

                            <div class="text-center mt-3">
                                <a href="#" class="text-decoration-none">Mot de passe oublié ?</a>
                            </div>
                            <hr class="my-4">
                            <p class="text-center text-muted">
                                Pas de compte ?
                                <a href="{{ path('app_inscription') }}" class="text-decoration-none">
                                    S'inscrire
                                </a>
                            </p>
                        </div>
                    </div>

                    {# Inscription rapide #}
                    <div class="col-md-6 bg-light">
                        <div class="card-body p-5">
                            <h2 class="card-title mb-4">Créer un compte</h2>
                            <p class="text-muted">
                                Rejoignez Ma Boutique et profitez de :
                            </p>
                            <ul class="list-unstyled">
                                <li class="mb-2">✅ Suivi de vos commandes</li>
                                <li class="mb-2">✅ Historique d'achats</li>
                                <li class="mb-2">✅ Offres exclusives</li>
                            </ul>
                            <div class="d-grid mt-4">
                                <a href="{{ path('app_inscription') }}"
                                   class="btn btn-success btn-lg">
                                    Créer mon compte
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
